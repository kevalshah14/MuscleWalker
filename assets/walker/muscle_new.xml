<mujoco model="muscle_walker">
  <include file="./common/visual.xml"/>
  <include file="./common/skybox.xml"/>
  <include file="./common/materials.xml"/>

  <option cone="pyramidal" ls_iterations="5" iterations="1">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <numeric data="2" name="max_contact_points"/>
    <numeric data="2" name="max_geom_pairs"/>
  </custom>

  <option timestep="0.0025"/>

  <statistic extent="2" center="0 0 1"/>

  <default>
    <joint damping=".1" armature="0.01" limited="true" solimplimit="0 .99 .01"/>
    <geom contype="1" conaffinity="0" friction=".7 .1 .1"/>
    <site size="0.02"/>
    <default class="walker">
      <geom material="self" type="capsule"/>
      <joint axis="0 -1 0"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" pos="0 0 -.05" size="40 40 40" type="plane" conaffinity="1" material="grid"/>
    <!-- Free-floating torso with root joints for walking -->
    <body name="torso" pos="0 0 1.3" childclass="walker">
      <light name="light" pos="0 0 2" mode="trackcom"/>
      <camera name="side" pos="0 -2 .7" euler="60 0 0" mode="trackcom"/>
      <camera name="back" pos="-2 0 .5" xyaxes="0 -1 0 1 0 3" mode="trackcom"/>
      <!-- Root joints - HEAVILY damped to prevent torso from moving and destabilizing -->
      <joint name="rootx" axis="1 0 0" type="slide" limited="false" armature="0" damping="10.0"/>
      <joint name="rootz" axis="0 0 1" type="slide" limited="false" armature="0" damping="50.0"/>
      <joint name="rooty" axis="0 1 0" type="hinge" limited="false" armature="0" damping="20.0"/>
      <geom name="torso" size="0.07 0.3" />
      
      <!-- Right hip tendon attachment sites -->
      <site name="torso_right_hip_flex" pos="0.05 -.05 0.2" size="0.02" group="1"/>
      <site name="torso_right_hip_ext_1" pos="-0.05 -.05 -0.0" size="0.02" group="1"/>
      <site name="torso_right_hip_ext_2" pos="-0.05 -.05 -0.4" size="0.02" group="1"/>

      <site name="torso_left_hip_flex" pos="0.05 0.05 0.2" size="0.02" group="1"/>
      <site name="torso_left_hip_ext_1" pos="-0.05 0.05 0.0" size="0.02" group="1"/>
      <site name="torso_left_hip_ext_2" pos="-0.05 0.05 -0.4" size="0.02" group="1"/>
      
      <body name="right_thigh" pos="0 -.05 -0.3">
        <joint name="right_hip" range="0 135" damping="5.0"/>
        <geom name="right_thigh" pos="0 0 -0.225" size="0.05 0.225"/>
        <!-- Right hip tendon sites on thigh -->
        <site name="right_thigh_hip_flex" pos="0.05 0 -0.1" size="0.02" group="1"/>
        <site name="right_thigh_hip_ext" pos="-0.05 0 -0.2" size="0.02" group="1"/>
    
        <!-- Right knee tendon sites on thigh (exactly like test_knee.xml) -->
        <site name="right_thigh_knee_ext_1" pos="0.05 0 -0.225" size="0.02" group="1"/>
        <site name="right_thigh_knee_ext_2" pos="0.0 0 -0.625" size="0.02" group="1"/>
        <site name="right_thigh_knee_flex" pos="-0.05 0 -0.1" size="0.02" group="1"/>
        
        <body name="right_leg" pos="0 0 -0.7">
          <!-- Joint: range inverted for knee (negative = extended, 0 = flexed) -->
          <joint name="right_knee" type="hinge" axis="0 -1 0" pos="0 0 0.25" damping="1.0" range="-150 0"/>
          <geom name="right_leg" size="0.04 0.25"/>
          <!-- Right knee tendon sites on leg (exactly like test_knee.xml) -->
          <site name="right_leg_knee_ext" pos="0.05 0 0.0" size="0.02" group="1"/>
          <site name="right_leg_knee_flex" pos="-0.05 0 0.15" size="0.02" group="1"/>
          <!-- Right ankle tendon sites on leg -->
          <site name="right_leg_ankle_flex" pos="0.05 0 0.1" size="0.02" group="1"/>
          <site name="right_leg_ankle_ext" pos="-0.05 0 0" size="0.02" group="1"/>
          
          <body name="right_foot" pos="0.06 0 -0.25">
            <joint name="right_ankle" pos="-0.06 0 0" range="-45 45"/>
            <geom name="right_foot" zaxis="1 0 0" size="0.06 0.15"/>
            <!-- Right ankle tendon sites on foot -->
            <site name="right_foot_ankle_flex" pos="0.0 0 0.05" size="0.02" group="1"/>
            <site name="right_foot_ankle_ext" pos="-0.2 0 0.05" size="0.02" group="1"/>
          </body>
        </body>
      </body>
      
      
      <body name="left_thigh" pos="0 .05 -0.3">
        <joint name="left_hip" range="-45 135" damping="5.0"/>
        <geom name="left_thigh" pos="0 0 -0.225" size="0.05 0.225"/>

        <site name="left_thigh_hip_flex" pos="0.05 0 -0.1" size="0.02" group="1"/>
        <site name="left_thigh_hip_ext" pos="-0.05 0 -0.2" size="0.02" group="1"/>

        <!-- Left knee tendon sites -->
        <site name="left_thigh_knee_ext_1" pos="0.05 0 -0.225" size="0.02" group="1"/>
        <site name="left_thigh_knee_ext_2" pos="0.0 0 -0.625" size="0.02" group="1"/>
        <site name="left_thigh_knee_flex" pos="-0.05 0 -0.1" size="0.02" group="1"/>
        
        <body name="left_leg" pos="0 0 -0.7">
          <!-- Joint: range inverted for knee (negative = extended, 0 = flexed) -->
          <joint name="left_knee" type="hinge" axis="0 -1 0" pos="0 0 0.25" damping="1.0" range="-150 0"/>
          <geom name="left_leg" size="0.04 0.25"/>

          <site name="left_leg_knee_ext" pos="0.05 0 0.0" size="0.02" group="1"/>
          <site name="left_leg_knee_flex" pos="-0.05 0 0.15" size="0.02" group="1"/>
          <!-- Left ankle tendon sites -->
          <site name="left_leg_ankle_flex" pos="0.05 0 0.1" size="0.02" group="1"/>
          <site name="left_leg_ankle_ext" pos="-0.05 0 0" size="0.02" group="1"/>

          
          <body name="left_foot" pos="0.06 0 -0.25">
            <joint name="left_ankle" pos="-0.06 0 0" range="-45 45"/>
            <geom name="left_foot" zaxis="1 0 0" size="0.06 0.15"/>

            <site name="left_foot_ankle_flex" pos="0.0 0 0.05" size="0.02" group="1"/>
            <site name="left_foot_ankle_ext" pos="-0.2 0 0.05" size="0.02" group="1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Tendons: Following muscle.xml pattern - one active (stiffness=0) and one passive (stiffness=100) per joint -->
  <tendon>
    <!-- Right hip tendons -->
    <spatial name="right_hip_flexor" springlength="0.4" stiffness="0" damping="0.0" width="0.01" rgba="1 0 0 1">
      <site site="torso_right_hip_flex"/>
      <site site="right_thigh_hip_flex"/>
    </spatial>
    <spatial name="right_hip_extensor" springlength="0.45" stiffness="4000" damping="5.0" width="0.01" rgba="0 0 1 1">
      <site site="torso_right_hip_ext_1"/>
      <site site="torso_right_hip_ext_2"/>
      <site site="right_thigh_hip_ext"/>
    </spatial>

    <spatial name="right_knee_extensor" springlength="0.45" stiffness="1500" damping="5.0" width="0.01" rgba="0 0 1 1">
      <site site="right_thigh_knee_ext_1"/>
      <site site="right_thigh_knee_ext_2"/>
      <site site="right_leg_knee_ext"/>
    </spatial>
    <spatial name="right_knee_flexor" springlength="0.4" stiffness="0" damping="0.0" width="0.01" rgba="1 0 0 1">
      <site site="right_thigh_knee_flex"/>
      <site site="right_leg_knee_flex"/>
    </spatial>

    <spatial name="right_ankle_flexor" springlength="0.2022" stiffness="0" damping="0.0" width="0.01" rgba="1 0 0 1">
      <site site="right_leg_ankle_flex"/>
      <site site="right_foot_ankle_flex"/>
    </spatial>
    <spatial name="right_ankle_extensor" springlength="0.1" stiffness="1500" damping="100.0" width="0.01" rgba="0 0 1 1">
      <site site="right_leg_ankle_ext"/>
      <site site="right_foot_ankle_ext"/>
    </spatial>

    <!-- Left hip tendons -->
    <spatial name="left_hip_flexor" springlength="0.4" stiffness="0" damping="0.0" width="0.01" rgba="1 0 0 1">
      <site site="torso_left_hip_flex"/>
      <site site="left_thigh_hip_flex"/>
    </spatial>
    <spatial name="left_hip_extensor" springlength="0.45" stiffness="4000" damping="5.0" width="0.01" rgba="0 0 1 1">
      <site site="torso_left_hip_ext_1"/>
      <site site="torso_left_hip_ext_2"/>
      <site site="left_thigh_hip_ext"/>
    </spatial>

    <!-- Left knee tendons -->
    <spatial name="left_knee_extensor" springlength="0.45" stiffness="1500" damping="5.0" width="0.01" rgba="0 0 1 1">
      <site site="left_thigh_knee_ext_1"/>
      <site site="left_thigh_knee_ext_2"/>
      <site site="left_leg_knee_ext"/>
    </spatial>
    <spatial name="left_knee_flexor" springlength="0.4" stiffness="0" damping="0.0" width="0.01" rgba="1 0 0 1">
      <site site="left_thigh_knee_flex"/>
      <site site="left_leg_knee_flex"/>
    </spatial>

    <!-- Left ankle tendons -->
    <spatial name="left_ankle_flexor" springlength="0.2022" stiffness="0" damping="0.0" width="0.01" rgba="1 0 0 1">
      <site site="left_leg_ankle_flex"/>
      <site site="left_foot_ankle_flex"/>
    </spatial>
    <spatial name="left_ankle_extensor" springlength="0.1" stiffness="1500" damping="100.0" width="0.01" rgba="0 0 1 1">
      <site site="left_leg_ankle_ext"/>
      <site site="left_foot_ankle_ext"/>
    </spatial>

  </tendon>
    

  <sensor>
    <subtreelinvel name="torso_subtreelinvel" body="torso"/>
  </sensor>

  <!-- Actuators: Following muscle.xml pattern - one muscle per joint connected to the active tendon (stiffness=0) -->
  <actuator>
    <!-- Right leg muscles - FIXED: control flexors (active tendons) -->
    <muscle name="right_hip_flex" tendon="right_hip_flexor" ctrlrange="0.0 1.0" force="5000"/>
    <muscle name="right_knee_flex" tendon="right_knee_flexor" ctrlrange="0.0 1.0" force="1500"/>
    <muscle name="right_ankle_flex" tendon="right_ankle_flexor" ctrlrange="0.0 1.0" force="1200"/>

    <muscle name="left_hip_flex" tendon="left_hip_flexor" ctrlrange="0.0 1.0" force="5000"/>
    <muscle name="left_knee_flex" tendon="left_knee_flexor" ctrlrange="0.0 1.0" force="1500"/>
    <muscle name="left_ankle_flex" tendon="left_ankle_flexor" ctrlrange="0.0 1.0" force="1200"/>
  </actuator>
</mujoco>

